# Studio — environment (copy to .env.local, fill with real values, never commit the filled file)

# Read-only connection to the VIP-TAXI production Postgres (created as a SELECT-only role).
# The app only ever runs SELECT against this.
VIP_DB_URL=postgresql://studio_ro:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Central store for the tracker's own tables (project registry, catalogue, cursors).
# Neon free tier. Separate from any client database.
STUDIO_DB_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# One developer login for the Studio dashboard itself.
STUDIO_AUTH_SECRET=change-me-to-a-long-random-string
STUDIO_PASSWORD=change-me

# Your office/team public IP(s), comma-separated — visits from these are excluded everywhere.
# Leave blank to set later from inside the app.
EXCLUDED_IPS=
